{
  "name": "@xts/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
