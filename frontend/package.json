    "test:smoke": "playwright test --config e2e/playwright.config.ts",
    "start:entra": "ng serve --configuration entra"
  },
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@azure/msal-browser": "^5.20.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.0",
    "vitest": "^5.0.0"
  }
