    "test:smoke": "playwright test --config e2e/playwright.config.ts",
    "start:entra": "ng serve --configuration entra"
  },
  "dependencies": {
    "@angular/animations": "^21.2.22",
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/platform-browser-dynamic": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@azure/msal-browser": "^5.20.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@playwright/test": "^1.46.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.0",
    "jsdom": "^24.1.1",
    "typescript": "~5.9.3",
    "vitest": "^2.0.5"
  }
